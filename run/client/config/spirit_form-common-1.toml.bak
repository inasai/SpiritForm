#Whether to log the dirt block on common setup
logDirtBlock = false
#A magic number
# Default: 42
# Range: > 0
magicNumber = 42
#What you want the introduction message to be for the magic number
magicNumberIntroduction = "The magic number is... "
#A list of items to log on common setup.
items = ["minecraft:iron_ingot"]

[spirit]
	#comment.spirit.highlightRadius
	# Default: 10.0
	# Range: 1.0 ~ 128.0
	highlightRadius = 15.0
	#comment.spirit.invisibilityDurationSeconds
	# Default: 60
	# Range: 1 ~ 3600
	invisibilityDurationSeconds = 5
	#comment.spirit.abilityHungerCost
	# Default: 6
	# Range: 0 ~ 20
	abilityHungerCost = 6
	#comment.spirit.teleportRange
	# Default: 64.0
	# Range: 1.0 ~ 256.0
	teleportRange = 64.0
	#comment.spirit.abilityCooldownSeconds
	# Default: 5
	# Range: 0 ~ 3600
	abilityCooldownSeconds = 1
